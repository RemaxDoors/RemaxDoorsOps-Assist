# ---------------------------------------------------------------------------
# remax DOORS — Operation Help. Copy to .env.local (which is git-ignored).
# ---------------------------------------------------------------------------

# --- M1 (SQL Server) -------------------------------------------------------
DB_SERVER=your-sql-server
DB_NAME=M1_RP
DB_USER=ops_assist_app
DB_PASSWORD=
DB_PORT=1433
DB_SCHEMA=dbo
DB_ENCRYPT=true
# Set to false only if the server presents a certificate you trust externally.
DB_TRUST_SERVER_CERT=true

# --- Sign-in ---------------------------------------------------------------
# Handled by Azure App Service Authentication, not by this app, so there are
# no client ids or secrets here. Configure it in the portal:
#   App Service -> Settings -> Authentication -> Add identity provider
#   -> Microsoft, and set "Restrict access" to ALLOW UNAUTHENTICATED.
# Requiring authentication there would block /api/health and every API-key
# caller at the platform edge, before this app can decide.
#
# App Service is not in front of `next dev`, so local development has no
# principal headers and nobody could sign in. This skips the check.
AUTH_DEV_BYPASS=true
# Used for absolute links in outbound content; not part of sign-in.
APP_BASE_URL=http://localhost:4080

# --- Simpro (optional) -----------------------------------------------------
SIMPRO_BASE_URL=
SIMPRO_API_TOKEN=

# --- API access ------------------------------------------------------------
# Long random string. Send as X-API-Key to call /api/* without a session.
API_KEY=

# --- Attachments -----------------------------------------------------------
# Where uploaded photos/files are written. M1 stores the path, so this must be
# a location M1 users can also reach (e.g. a mapped share).
ATTACHMENT_DIR=./uploads

# --- Simpro ----------------------------------------------------------------
SIMPRO_COMPANY_ID=0
# Path to a Simpro job page, stored in M1's ucmaSimproLink. Placeholder:
# {jobId}. Correct this if your Simpro uses a different URL.
SIMPRO_JOB_URL_TEMPLATE=/staff/projectJob.php?jobID={jobId}
SIMPRO_ENGINEERING_STAFF_ID=
SIMPRO_PROJECT_MANAGER_STAFF_ID=

# Local port; hosting platforms supply their own PORT.
PORT=4080

# Where submissions wait when M1 is unreachable
QUEUE_DIR=./queue
